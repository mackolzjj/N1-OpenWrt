# N1 single-arm bypass router preset for honk-core
# LAN device is eth0 (see /etc/config/network); WAN follows the IPv4 default route.
global {
    wan_interface: auto
    lan_interface: eth0
    log_level: info
    dial_mode: domain++
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk/data'
    log_file: ''
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    check_interval: 300s
    bootstrap_resolver: '223.5.5.5:53'
    nfqueue_enable: true
}

dns {
    upstream {
        local: 'udp://127.0.0.1:53'
    }
    routing {
        request {
            fallback: local
        }
        response {
            fallback: local
        }
    }
}

routing {
    # Keep router DNS out of the cgroup hooks: otherwise 127.0.0.1:53 is
    # intercepted by honk itself and every lookup returns SERVFAIL.
    pname(dnsmasq, honk-core) -> direct(must)
    l4proto(udp) && dport(53) -> direct(must)
    fallback: direct
}

experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
        default_mode: 'Rule'
    }
    native_api {
        enabled: true
        listen: '0.0.0.0:9527'
        password_auth: true
        config_write: true
        ui: 'embedded'
    }
    cache_file {
        enabled: true
    }
}
